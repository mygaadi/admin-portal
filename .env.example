# Backend is exposed via an ephemeral Cloudflare tunnel that changes whenever
# the backend dev restarts it. Copy this file to .env and update the URL —
# see CLAUDE.md for the current value / how to get a fresh one.
VITE_API_BASE_URL=https://downloading-bible-shoot-gulf.trycloudflare.com

# Set to "true" to show the mock-login buttons in a production build (e.g.
# a Vercel deployment used for demos, with no real backend to log into yet).
# Leave unset once real login exists — anyone with the deployment URL can
# use this to get full Admin/Station Manager access to the mock data.
VITE_ENABLE_MOCK_AUTH=true
